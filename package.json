{
  "name": "featurelens-research",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven product feature research through CLI and MCP",
  "type": "module",
  "bin": {
    "featurelens": "bin/zhiwei.mjs",
    "zhiwei": "bin/zhiwei.mjs"
  },
  "scripts": {
    "start": "node bin/zhiwei.mjs",
    "test": "node --test tests/*.test.mjs",
