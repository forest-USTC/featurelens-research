  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/forest-USTC/featurelens-research.git"
  }
}
